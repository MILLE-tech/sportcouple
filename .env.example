# Copie ce fichier en .env.local et remplis les valeurs depuis
# Supabase > Project Settings > API (plan gratuit, aucune carte requise).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Raccourci de connexion admin : taper "admin" / "admin" sur /login se
# substitue ces vraies valeurs (le compte réel, créé une fois via /signup
# puis marqué is_admin=true en base — voir supabase/migrations/0004).
# Ne jamais préfixer par NEXT_PUBLIC_, ne jamais committer les vraies valeurs.
ADMIN_SHORTCUT_EMAIL=admin@example.com
ADMIN_SHORTCUT_PASSWORD=un-mot-de-passe-au-choix
