# Copie ce fichier en .env.local et remplis les valeurs depuis
# Supabase > Project Settings > API (plan gratuit, aucune carte requise).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Raccourci de connexion admin : taper "admin" / "admin" sur /login se
# substitue le mot de passe réel du compte admin (créé directement en base,
# voir supabase/migrations/0005). Doit être identique au mot de passe mis
# dans ce script SQL. Ne jamais préfixer par NEXT_PUBLIC_, ne jamais
# committer la vraie valeur.
ADMIN_SHORTCUT_PASSWORD=un-mot-de-passe-au-choix
